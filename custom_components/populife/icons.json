{
  "entity": {
    "button": {
      "sync_time": {
        "default": "mdi:clock-check-outline"
      },
      "refresh": {
        "default": "mdi:refresh"
      },
      "passcode_generate": {
        "default": "mdi:dice-multiple"
      },
      "passcode_add": {
        "default": "mdi:plus-circle-outline"
      },
      "passcode_delete_selected": {
        "default": "mdi:delete-outline"
      }
    },
    "event": {
      "operation": {
        "default": "mdi:history"
      }
    },
    "number": {
      "auto_lock_delay": {
        "default": "mdi:timer-lock-outline"
      }
    },
    "sensor": {
      "last_unlock": {
        "default": "mdi:lock-open-variant-outline"
      },
      "last_unlock_method": {
        "default": "mdi:account-key-outline",
        "state": {
          "app": "mdi:cellphone-key",
          "keypad": "mdi:dialpad",
          "fingerprint": "mdi:fingerprint",
          "card": "mdi:card-account-details-outline",
          "key": "mdi:key-variant",
          "gateway": "mdi:router-wireless",
          "remote": "mdi:remote"
        }
      },
      "clock_drift": {
        "default": "mdi:clock-alert-outline"
      },
      "fingerprints": {
        "default": "mdi:fingerprint"
      },
      "passcodes": {
        "default": "mdi:dialpad"
      },
      "last_unlock_user": {
        "default": "mdi:account-key"
      }
    },
    "switch": {
      "lock_sound": {
        "default": "mdi:volume-high",
        "state": {
          "off": "mdi:volume-off"
        }
      }
    },
    "select": {
      "lock_volume": {
        "default": "mdi:volume-medium",
        "state": {
          "low": "mdi:volume-low",
          "high": "mdi:volume-high"
        }
      },
      "passcode_type": {
        "default": "mdi:timer-sand",
        "state": {
          "permanent": "mdi:infinity"
        }
      },
      "passcode_delete": {
        "default": "mdi:account-remove-outline"
      }
    },
    "text": {
      "passcode_name": {
        "default": "mdi:account-tag-outline"
      },
      "passcode_code": {
        "default": "mdi:dialpad"
      }
    },
    "datetime": {
      "passcode_start": {
        "default": "mdi:calendar-start"
      },
      "passcode_end": {
        "default": "mdi:calendar-end"
      }
    }
  },
  "services": {
    "add_passcode": {
      "service": "mdi:dialpad"
    },
    "delete_passcode": {
      "service": "mdi:backspace-outline"
    },
    "clear_passcodes": {
      "service": "mdi:delete-sweep-outline"
    },
    "list_passcodes": {
      "service": "mdi:format-list-numbered"
    },
    "list_fingerprints": {
      "service": "mdi:fingerprint"
    }
  }
}
